{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MIRA-Intelligence/mira-skills/main/schemas/mirahub.schema.json",
  "title": "mirahub.yaml",
  "description": "Hub-only metadata that lives next to SKILL.md inside each skill folder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "version", "tags"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Lowercase kebab-case identifier. Must equal the parent folder name and SKILL.md `name`."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "SemVer. Used to name the published zip and detect updates."
    },
    "maturity": {
      "type": "string",
      "enum": ["stable", "beta", "experimental"],
      "default": "experimental"
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier preferred (e.g. MIT, Apache-2.0, GPL-3.0-or-later)."
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      },
      "description": "Hub listing abstract per site language. Defaults to SKILL.md `description` for the language it is written in; the other language must be given here."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "github": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "homepage": { "type": "string", "format": "uri" },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "format": "uri" },
        "docs": { "type": "string", "format": "uri" },
        "issues": { "type": "string", "format": "uri" }
      }
    },
    "cover": {
      "type": "string",
      "description": "Relative path inside the skill folder. PNG/JPG/WebP, ~1200x630 recommended."
    },
    "screenshots": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "maxItems": 12
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:_-]{0,63}$",
        "description": "Flat tag. Use `<namespace>:<value>` for faceted attributes (e.g. domain:radiology, functionality:analysis, lang:python)."
      }
    }
  }
}
